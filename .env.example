# VoxDrop Environment Variables
# Kopiere diese Datei zu .env und passe die Werte an
# WICHTIG: Alle mit [REQUIRED] markierten Variablen MÜSSEN gesetzt werden!

# ============================================
# SICHERHEIT [REQUIRED]
# ============================================

# JWT Secret für Token-Signierung
# WICHTIG: Generiere einen sicheren, zufälligen String (mind. 32 Zeichen)
# Beispiel: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32

# Salt für IP-Hashing (DSGVO-Anonymisierung)
# WICHTIG: Generiere einen sicheren, zufälligen String (mind. 32 Zeichen)
# Beispiel: openssl rand -hex 32
IP_HASH_SALT=CHANGE_ME_generate_with_openssl_rand_hex_32

# ============================================
# WHISPER TRANSCRIPTION
# ============================================

# Option 1: OpenAI Whisper API (für Cloud-Deployment)
# Kosten: ~$0.006 pro Minute Audio
# ACHTUNG: Nicht DSGVO-konform (Daten gehen zu OpenAI)
# OPENAI_API_KEY=sk-your-openai-api-key-here

# Option 2: Lokaler Whisper Service (für Hetzner GPU Server)
# Vollständig DSGVO-konform - alle Daten bleiben lokal
WHISPER_SERVICE_URL=http://whisper:8000

# Whisper Modell (tiny, base, small, medium, large, large-v2, large-v3)
WHISPER_MODEL=large-v3

# ============================================
# PPTX SUMMARY SERVICE
# ============================================

# PPTX Accessibility Summary Service URL
PPTX_SERVICE_URL=http://pptx-service:8003

# ============================================
# AVATAR SERVICE
# ============================================

# Sprechender Avatar Service URL
AVATAR_SERVICE_URL=http://avatar-service:8005

# ============================================
# SERVER
# ============================================

# Port für den Webserver
PORT=5000

# Node Environment
NODE_ENV=production

# Host (0.0.0.0 für Docker)
HOST=0.0.0.0

# ============================================
# EMAIL (Benachrichtigungen / Verifikation)
# ============================================
#
# VoxDrop kann E-Mails senden fuer:
# - Account-Verifikation
# - Job-Fertigstellung (z.B. Transkription / PPTX -> PDF/UA)
#
# Provider: Resend (https://resend.com)
# Wenn RESEND_API_KEY fehlt, werden E-Mails nicht versendet.
#
# RESEND_API_KEY=re_your_resend_api_key
#
# Optional: Absender/Branding
# FROM_EMAIL=VoxDrop <noreply@voxdrop.live>
# APP_URL=https://voxdrop.live
# EMAIL_LOGO_URL=https://voxdrop.live/favicon.svg

# ============================================
# ON-PREM / BEHÖRDEN MODUS (Optional)
# ============================================
#
# Wenn du sicherstellen willst, dass VoxDrop keine externen Netzwerkanfragen macht:
# HARD_DISABLE_EXTERNAL_NETWORK=true
#
# Registrierung im UI deaktivieren (SSO/Invite-only/Manuelle Userpflege):
# REGISTRATION_ENABLED=false
#
# Bestehende User zu Admin promoten (kommagetrennte Liste):
# BOOTSTRAP_ADMIN_EMAILS=admin@example.de
#
# Web-Proxy Endpoint (ARIA/Web-Checks) deaktivieren:
# PROXY_ENABLED=false

# ============================================
# DATENBANK
# ============================================

# Pfad zur SQLite-Datenbank (relativ zum Projektverzeichnis)
# DATABASE_PATH=data/voxdrop.db

# Datenverzeichnis
# DATA_DIR=data

# ============================================
# LEMONSQUEEZY PAYMENT [REQUIRED for Billing]
# ============================================

# LemonSqueezy API Key (aus Settings > API)
LEMONSQUEEZY_API_KEY=your_api_key_here

# LemonSqueezy Store ID (aus Settings > Stores)
LEMONSQUEEZY_STORE_ID=your_store_id_here

# Webhook Signing Secret (aus Settings > Webhooks)
LEMONSQUEEZY_WEBHOOK_SECRET=your_webhook_secret_here

# ============================================
# DEPLOYMENT CHECKLISTE
# ============================================

# Vor dem Deployment sicherstellen:
# [ ] JWT_SECRET ist ein sicherer, zufälliger String
# [ ] IP_HASH_SALT ist ein sicherer, zufälliger String
# [ ] SSL-Zertifikate sind konfiguriert
# [ ] Firewall ist konfiguriert (nur Ports 80/443 offen)
# [ ] Backup-Strategie ist eingerichtet
# [ ] Monitoring ist aktiv

# ============================================
# KRITIS-HINWEISE
# ============================================

# Für KRITIS-Konformität zusätzlich beachten:
# - Audit-Logs regelmäßig exportieren und archivieren
# - MFA für Admin-Accounts erzwingen
# - Regelmäßige Sicherheitsupdates einspielen
# - Penetrationstests durchführen
# - Incident Response Plan erstellen

# ============================================
# BFSG QUICK-SCAN
# ============================================

# Basis-URL zur Main-App API (Fallback für Callback/Abfrage in separatem Worker-Modus)
BFSG_WEB_CALLBACK_BASE_URL=http://web:5000

# Scanner-Service URL (Container-Hostname im Deployment beachten)
BFSG_SCAN_WORKER_URL=http://bfsg-scan-worker:3001

# Sicherheits-/Feature-Flags
BFSG_SCAN_ENABLED=true
BFSG_SCAN_CALLBACK_KEY=

# Rate-Limits
BFSG_RATE_LIMIT_IP_PER_HOUR=5
BFSG_RATE_LIMIT_EMAIL_PER_DAY=3
BFSG_RATE_LIMIT_GLOBAL_PER_MIN=20

# Cache
BFSG_SCAN_CACHE_TTL_HOURS=24

# Scan-Worker-Tuning
BFSG_INFLIGHT_SCAN_TTL_MINUTES=120
MAX_CONCURRENT_SCANS=2
SCAN_TIMEOUT_MS=120000
MAX_PDFS_PER_SCAN=10
MAX_PDF_SIZE_MB=50
PDF_CONCURRENCY=3
MAX_DOM_BYTES=10000000

# ============================================
# JOB-RELIABILITY (Queue/GPU)
# ============================================
VOXDROP_GPU_SLOT_LIMIT=1
VOXDROP_GPU_SLOT_ACQUIRE_TIMEOUT_MS=2700000
VOXDROP_PODCAST_QUEUE_CONCURRENCY=1
VOXDROP_SUBTITLE_EMBED_QUEUE_CONCURRENCY=1
VOXDROP_GPU_QUEUE_CAP_PODCAST=1
VOXDROP_GPU_QUEUE_CAP_SUBTITLE_EMBED=1
PODCAST_POLL_MAX_MINUTES=90
PODCAST_PACK_POLL_MAX_MINUTES=20
VOXDROP_SUBTITLE_EMBED_MIN_GPU_FREE_MB=1500
VOXDROP_SUBTITLE_EMBED_CONCURRENCY=1

{
  "name": "voxdrop",
  "version": "2.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "NODE_ENV=development tsx server/index.ts",
    "build": "vite build && node scripts/prerender.mjs && esbuild server/index.ts --platform=node --packages=external --external:./vite --external:../vite.config --bundle --format=esm --outdir=dist",
    "prerender": "node scripts/prerender.mjs",
    "start": "NODE_ENV=production node dist/index.js",
    "check": "tsc",
    "verify:routes": "node scripts/verify-route-imports.mjs",
    "db:verify": "node scripts/verify-db-init.mjs",
    "db:backup": "node scripts/db-backup.mjs",
    "db:restore": "node scripts/db-restore.mjs",
    "release:verify": "npm run verify:routes && npm run db:verify && npm run check && npm run build && npm run promptfoo:security:validate",
    "seed:test": "tsx -r dotenv/config server/db/seed-test-account.ts",
    "promptfoo:view": "npx -y promptfoo view",
    "promptfoo:security:chat:validate": "npx -y promptfoo validate config -c promptfooconfig.security.chat.yaml",
    "promptfoo:security:commands:validate": "npx -y promptfoo validate config -c promptfooconfig.security.commands.yaml",
    "promptfoo:security:simplify:validate": "npx -y promptfoo validate config -c promptfooconfig.security.simplify.yaml",
    "promptfoo:security:validate": "npm run promptfoo:security:chat:validate && npm run promptfoo:security:commands:validate && npm run promptfoo:security:simplify:validate",
    "promptfoo:security:local": "bash scripts/run-promptfoo-security-smokes-local.sh",
    "promptfoo:security:server": "bash scripts/run-promptfoo-server-security-smokes.sh",
    "ops:runtime-status": "bash scripts/runtime-status.sh",
    "ops:capture:prod-state": "bash scripts/capture-production-state.sh"
  },
